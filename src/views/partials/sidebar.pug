//- =====================================================
//- src/views/partials/sidebar.pug
//- =====================================================

mixin sidebar(options)
    - options = options || {}
    - var activePath = options.activePath || currentPath || ""
    - var navigation = [{ name: 'Dashboard', href: '/dashboard', icon: "far fa-cubes fa-lg", roles: ['admin', 'goods_receiving', 'technician', 'qc_inspector', 'analyzer', 'default'] },{ name: 'Devices', href: '/devices', icon: "far fa-mobile fa-lg", roles: ['admin', 'goods_receiving', 'technician', 'qc_inspector', 'analyzer'] },{ name: 'Repairs', href: '/repairs', icon: "far fa-wrench fa-lg", roles: ['admin', 'technician'] },{ name: 'Quality Check', href: '/qc', icon: "far fa-clipboard fa-lg", roles: ['admin', 'qc_inspector'] },{ name: 'Rework Analysis', href: '/rework', icon: "far fa-triangle-exclamation fa-lg", roles: ['admin', 'analyzer'], badge: 'rework' },{ name: 'Parts Inventory', href: '/parts', icon: "far fa-box fa-lg", roles: ['admin', 'technician'] },{ name: 'Reports', href: '/reports', icon: "far fa-chart-column fa-lg", roles: ['admin', 'analyzer'] },{ name: 'Plenty Sync', href: '/sync', icon: "far fa-arrows-rotate fa-lg", roles: ['admin', 'goods_receiving'], badge: 'sync' },{ name: 'Users', href: '/users', icon: "far fa-users fa-lg", roles: ['admin'] },{ name: 'Settings', href: '/settings', icon: "far fa-gear fa-lg", roles: ['admin'] }];
    - var userRole = options.role || (user && user.role) || "guest"
    - var filteredNav = navigation.filter(item => { if (!user) return item.roles.includes('default'); return item.roles.includes(userRole); });
    - var getBadgeCount = (badgeType) => { if (badgeType === "rework" ) return stats.reworkRate.total; if (badgeType === "sync") return jobQueue.unsynced.total; }

    .sidebar__header(class="flex h-16 items-center gap-2 border-b border-border px-4" data-css="sidebar__header")
        .sidebar__logo(class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-primary" data-css="sidebar__logo")
            i.far.fa-wrench.fa-lg
        .sidebar__brand(class="flex flex-col" data-css="sidebar__brand")
            .sidebar__brand-title(class="text-sm font-bold text-foreground" data-css="sidebar__brand-title") RepairTech
            .sidebar__brand-subtitle(class="text-xs text-muted-foreground" data-css="sidebar__brand-subtitle") Dashboard
        button(data-sidebar-resizer class="" data-css="sidebar__resizer")
            i.far.fa-sidebar.fa-lg

    nav(role="navigation" aria-label="Hauptnavigation" class="flex-1 space-y-1 overflow-y-auto p-3" data-css="sidebar__nav")
        each item in filteredNav
            - var isActive = activePath === item.href;
            - var badgeCount = getBadgeCount(item.badge);
            a(href=item.href hx-get=item.href hx-target="#app-content" hx-push-url="true" hx-swap="innerHTML" class=`flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-all bg-primary/10 text-primary glow-primary ${isActive ? 'is-active' : ''}` data-css="sidebar__nav-link")
                span(class="h-5 w-5 text-primary" data-css="sidebar__nav-icon")
                    i(class=item.icon)
                span(class="flex-1" data-css="sidebar__nav-label")= item.name
                if (badgeCount > 0)
                    div(class=`inline-flex items-center rounded-full border px-2.5 py-0.5 font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent text-xs ${(item.badge === 'rework') ? 'bg-destructive text-destructive-foreground hover:bg-destructive/80' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'}` data-css="sidebar__nav-badge")= badgeCount

    .sidebar__footer(class="border-t border-border p-3" data-css="sidebar__footer")
        .sidebar__user(class="flex items-center gap-3 rounded-lg bg-sidebar-accent p-3" data-css="sidebar__user")
            .sidebar__user-avatar(class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/20 text-primary font-semibold text-sm" data-css="sidebar__user-avatar") DE
            .sidebar__user-info(class="flex-1 min-w-0" data-css="sidebar__user-info")
                .sidebar__user-name(class="truncate text-sm font-medium text-foreground" data-css="sidebar__user-name") #{user.firstName} #{user.lastName}
                .sidebar__user-role(class="truncate text-xs text-muted-foreground" data-css="sidebar__user-role")= user.role
            button(class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors" data-css="sidebar__logout")
                i.far.fa-arrow-right-from-bracket.fa-lg