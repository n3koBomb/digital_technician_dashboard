//- src/views/layout/auth.pug
//- Layout für Authentifizierung (Login, Reset, Onboarding)

extends base.pug

//- Partials
include ../partials/logo.pug
include ../partials/flash-message.pug

//- =====================================================
//- HEAD / STYLE
//- =====================================================
block head
    link(rel="stylesheet", href="/css/auth.css")

//- =====================================================
//- BODY / AUTH WRAPPER
//- =====================================================
block appRoot
    //- Zentrale Auth-Stage
    main.auth-main
        .auth-container
            //- Branding / Logo
            .auth-header
                +logo()
            //- Flash Messages (Errors, Success, Info)
            .auth-messages
                +flashMessage({dismissible: true})
            //- Auth-Content (Login, Register, Reset etc.)
            .auth-content
                block content
                    //- Default Fallback
                    p Auth-Content nicht definiert.
    //- Page-spezifische Scripts
    block pageScript
    //- Auth-weite Scripts (leichtgewichtig, kein App-Bundle)
    block appScripts
        script(src="/script/auth.js", defer)