//- src/views/layout/app.pug
//- Zentrales Application-Layout

extends base.pug

//- Globale Partials
include ../partials/sidebar.pug
include ../partials/topbar.pug
include ../partials/notifications.pug
include ../partials/footer.pug

//- =====================================================
//- BODY / APP WRAPPER
//- =====================================================
block body
    //- if isHX
    //-     block content
    //- else
    body.app-layout(data-layout="app")#root
        //- Notifications (global, overlayfähig)
        block notifications
            +notifications()

        //- Hauptcontainer
        .app-container(data-css="flex h-screen overflow-hidden")
            //- Sidebar (Navigation / Rollenabhängig)
            aside.app-sidebar(data-css="flex h-screen w-64 flex-col bg-gradient-sidebar border-r border-border")
                +sidebar({
                    activePath: currentPath,
                    user
                })
            //- Content-Bereich
            .app-main(data-css="flex flex-1 flex-col overflow-hidden")
                //- Topbar (User, Breadcrumbs, Actions)
                header.app-topbar(role="banner" data-css="sticky top-0 z-40 flex h-16 items-center gap-4 border-b border-border bg-background/95 backdrop-blur px-6")
                    +topbar({
                        activePath: currentPath,
                        user
                    })
                //- Seiteninhalt
                main.app-content#app-content
                    block content
                        //- Default Fallback
                        p App-Content nicht definiert.
                //- Footer
                footer.app-footer
                    +footer({showVersion: true, showEnv: true, showLinks: true})

        //- Modals (global gesammelt, damit z-index nicht eskaliert)
        block modals

        //- Page-spezifische Scripts
        block pageScript

        //- App-weite Scripts
        block appScripts
            script(src="/script/app.js", defer)
